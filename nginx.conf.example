# ==============================================================================
# Production Nginx Configuration for LogicSchedule
# Supports 100+ to 10k+ concurrent users, HTTP/1.1 keep-alive, Socket.IO, Next.js
# ==============================================================================

# 1. Connection Upgrade Mapping for WebSockets (RFC 6455)
# Ensures WebSocket upgrade requests pass 'upgrade', while standard HTTP gets 'close'
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 2. Distributed Rate Limiting Zones (DDoS & Brute-Force Shield)
limit_req_zone $binary_remote_addr zone=api_general_limit:10m rate=40r/s;
limit_req_zone $binary_remote_addr zone=auth_strict_limit:10m rate=5r/s;
limit_req_status 429;

# 3. Upstream Definitions with Connection Pooling
# Backend Node.js API cluster (Express + Socket.io)
upstream backend_cluster {
    least_conn; # Route traffic to worker with fewest active connections
    server 127.0.0.1:5000 max_fails=3 fail_timeout=10s;
    # server 127.0.0.1:5001 max_fails=3 fail_timeout=10s; # Scale horizontally by adding workers
    keepalive 64; # Maintain open TCP sockets to eliminate handshake overhead
}

# Frontend Next.js SSR / Static Server
upstream frontend_cluster {
    least_conn;
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# ==============================================================================
# HTTP Server (Port 80): Automatic Redirect to HTTPS & ACME Challenge
# ==============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name logicschedule.com www.logicschedule.com api.logicschedule.com;

    # Let's Encrypt / Certbot SSL validation path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all other HTTP traffic permanently to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ==============================================================================
# HTTPS Server (Port 443): Full Stack Unified Production Server
# ==============================================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name logicschedule.com www.logicschedule.com;

    # --------------------------------------------------------------------------
    # SSL / TLS Hardening (A+ Rating on SSL Labs)
    # --------------------------------------------------------------------------
    ssl_certificate /etc/letsencrypt/live/logicschedule.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/logicschedule.com/privkey.pem;

    # TLS Protocols & High-Security Ciphers (Reject insecure TLSv1.0 & TLSv1.1)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # SSL Session Optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:20m;
    ssl_session_tickets off;

    # OCSP Stapling (Speeds up SSL handshake & verifies certificate revocation)
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # --------------------------------------------------------------------------
    # Security Headers
    # --------------------------------------------------------------------------
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # --------------------------------------------------------------------------
    # Performance, Buffers & Compression
    # --------------------------------------------------------------------------
    client_max_body_size 25M;
    client_body_buffer_size 128k;

    # Prevent 502 Bad Gateway when receiving large JWT cookies or auth headers
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Timeouts (must correlate with Node.js keepAliveTimeout: 65s)
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Gzip Compression for JSON, JS, CSS, and HTML
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    # --------------------------------------------------------------------------
    # Health Probe (Used by AWS ALB / Uptime Kuma / Kubernetes)
    # --------------------------------------------------------------------------
    location /health {
        proxy_pass http://backend_cluster/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    # --------------------------------------------------------------------------
    # WebSockets: Real-time Multi-User Socket.IO
    # --------------------------------------------------------------------------
    location /socket.io/ {
        proxy_pass http://backend_cluster/socket.io/;
        proxy_http_version 1.1;

        # Upgrade headers for bidirectional WebSocket connection
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Disable buffering to guarantee instantaneous real-time packet delivery
        proxy_buffering off;

        # Extended timeouts to prevent idle WebSocket disconnections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Forward authentic client identifiers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --------------------------------------------------------------------------
    # Backend API Endpoints (Express Router)
    # --------------------------------------------------------------------------
    # Authentication endpoints (Strict Rate Limiting against credential stuffing)
    location ~* ^/(auth)/ {
        limit_req zone=auth_strict_limit burst=10 nodelay;

        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # General API resource endpoints
    location ~* ^/(teachers|batches|schedules|stats|students|demo-sessions|demo-slots|users|sales-people|demo-reports) {
        limit_req zone=api_general_limit burst=50 nodelay;

        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Automatic failover if an upstream worker terminates
        proxy_next_upstream error timeout invalid_header http_502 http_503;
    }

    # --------------------------------------------------------------------------
    # Next.js Static Asset Optimization (Browser Cache 1 Year)
    # --------------------------------------------------------------------------
    location /_next/static/ {
        proxy_pass http://frontend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Static assets in public folder (images, icons, fonts)
    location ~* \.(ico|css|js|gif|jpeg|jpg|png|woff|woff2|ttf|svg|eot)$ {
        proxy_pass http://frontend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    # --------------------------------------------------------------------------
    # Frontend SSR & Application Pages (Next.js)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://frontend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ==============================================================================
# Optional: Standalone API Subdomain Configuration (api.logicschedule.com)
# Use this block if you host the API on a dedicated subdomain instead of /api
# ==============================================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.logicschedule.com;

    ssl_certificate /etc/letsencrypt/live/logicschedule.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/logicschedule.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 25M;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location /socket.io/ {
        proxy_pass http://backend_cluster/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://backend_cluster/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location / {
        limit_req zone=api_general_limit burst=50 nodelay;
        proxy_pass http://backend_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
