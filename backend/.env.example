# Server Environment & Port Configuration
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata

# Security & JWT Authentication Secret (MUST be changed in production!)
JWT_SECRET=your_production_jwt_secret_key_here

# Frontend Application Origin (Comma-separated for multiple domains)
FRONTEND_URL=https://your-domain.com,http://localhost:3000

# Default System Admin Account Initial Credentials
ADMIN_EMAIL=admin@logicschedule.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Firebase Admin SDK Configuration (Option 1: Base64 or JSON String)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT=ey... (base64 string)

# Firebase Admin SDK Configuration (Option 2: Individual Vars)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
